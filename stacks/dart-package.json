{
  "name": "dart-package",
  "detect": ["pubspec.yaml"],
  "source_ext": [".dart"],
  "generated_suffixes": [".g.dart", ".freezed.dart", ".mocks.dart"],
  "sdk_prefix_when": [".fvmrc", ".fvm/fvm_config.json"],
  "sdk_prefix": ["fvm"],
  "autofix": [["dart", "format", "{files}"]],
  "analyze": {
    "cmd": ["dart", "analyze", "--format=machine", "{files}"],
    "parser": "dart_machine",
    "severity_map": {"ERROR": "critical", "WARNING": "major", "INFO": "minor"}
  },
  "test": {
    "cmd": ["dart", "test", "{files}"],
    "flaky_retries": 1
  },
  "g1_task_reviewer": "dart-architecture",
  "g1_reviewers": ["dart-architecture", "dart-correctness", "dart-security"],
  "g2_agent": "qa-flutter",
  "g2_device": "macos",
  "rules_dir": ".claude/rules",
  "adr_dir": "docs/adr"
}
